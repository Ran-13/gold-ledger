{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Gold Ledger",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    "dialog:default",
    "fs:default",
    "allow-backup-database",
    "allow-restore-database",
    "allow-get-db-file-path",
    "allow-auto-backup-database",
    "allow-get-auto-backup-status",
    "allow-get-backups-dir"
  ]
}
